# Conexión a PostgreSQL (la misma que levanta `make db`). OBLIGATORIA.
DATABASE_URL=postgresql://pulse:pulse@localhost:5433/pulse

# Token que el worker manda en la cabecera X-Ingest-Token. Debe ser IGUAL en worker/.env.
# Si lo dejas vacío, cualquiera que alcance el backend puede inyectar chequeos falsos.
INGEST_TOKEN=cambia-esto-por-un-valor-largo-y-aleatorio

# Modo de solo lectura (true/false): bloquea crear, editar, anclar y borrar servicios. Útil para una demo pública.
CHRONO_SOLO_LECTURA=false

# Orígenes extra para CORS, separados por comas (localhost y 127.0.0.1 siempre se permiten).
# CORS_ORIGINS=https://chrono.midominio.com

# Por defecto NO se aceptan servicios que apunten a la red interna (localhost, 192.168.x.x…).
# Ponlo en true solo si quieres monitorear servicios locales.
PERMITIR_OBJETIVOS_PRIVADOS=false

# Cuántos chequeos seguidos hacen falta para abrir / cerrar un incidente (evita rachas por un solo mal chequeo).
INCIDENTE_ABRIR_TRAS=2
INCIDENTE_CERRAR_TRAS=3

# Días que se conservan los chequeos crudos (0 = no borrar nunca). Los incidentes se conservan siempre.
RETENCION_DIAS=30

LOG_LEVEL=INFO
