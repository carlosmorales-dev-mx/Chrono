# Copia este archivo como .env para cambiar la configuración local.

# URL del backend (FastAPI). Si no la pones, usa http://127.0.0.1:8001
VITE_API_URL=http://127.0.0.1:8001

# URL del WebSocket. Si no la pones, se deriva de VITE_API_URL
# VITE_WS_URL=ws://127.0.0.1:8001/ws

# Modo demo permanente (datos simulados, sin backend).
# También puedes abrir cualquier build con ?demo en la URL.
# VITE_DEMO=true
