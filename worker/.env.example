# Dónde está el backend.
BACKEND_URL=http://127.0.0.1:8001

# Debe ser IGUAL al INGEST_TOKEN de backend/.env (el backend rechaza los resultados si no coincide).
INGEST_TOKEN=cambia-esto-por-un-valor-largo-y-aleatorio

# Cada cuántos segundos se chequean los servicios (mínimo 5).
CHECK_INTERVAL=30

# Una respuesta correcta pero más lenta que esto (en milisegundos) cuenta como "degradado".
UMBRAL_DEGRADADO_MS=1200

# Segundos de espera por servicio antes de darlo por caído.
TIMEOUT_S=5

# Por defecto el worker NO se conecta a direcciones internas (localhost, 192.168.x.x…) aunque un nombre resuelva a ellas.
PERMITIR_OBJETIVOS_PRIVADOS=false

LOG_LEVEL=INFO
